DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_NAME=loop
DB_USER=loop
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

AI_MODEL=distilbert-base-uncased-finetuned-sst-2-english
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=700
GROQ_MAX_TOOL_ROUNDS=2

# Same Postgres database as Django's DATABASES setting, but in
# SQLAlchemy/psycopg3 URL form for langchain-postgres:
VECTOR_DATABASE_URL=postgresql+psycopg://loop:loop123@localhost:5432/loop
